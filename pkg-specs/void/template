# Maintainer: justpav05 <aksenovpaveldmitrievich@gmail.com>
pkgname=upac
version=0.1.4
revision=1
build_style=meta
hostmakedepends="make zig rust"
depends="ostree glib libarchive"
short_desc="A modular Linux package manager with OStree integration"
maintainer="justpav05 <aksenovpaveldmitrievich@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/justpav05/upac"

do_install() {
    vbin ${XBPS_BUILDDIR}/build/bin/upac

    vlib ${XBPS_BUILDDIR}/build/lib/libupac.so
    vlib ${XBPS_BUILDDIR}/build/lib/libupac-alpm.so
    vlib ${XBPS_BUILDDIR}/build/lib/libupac-rpm.so
    vlib ${XBPS_BUILDDIR}/build/lib/libupac-deb.so
    vlib ${XBPS_BUILDDIR}/build/lib/libupac-xbps.so

    vconfig ${XBPS_BUILDDIR}/pkg-specs/config.toml
}
