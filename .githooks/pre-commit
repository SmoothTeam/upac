#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged_rs_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')"

cargo fmt --all

if [ -n "$staged_rs_files" ]; then
    echo "$staged_rs_files" | while IFS= read -r file; do
        git add -- "$file"
    done
fi
